---
import Sections from '../components/Sections.astro';
import Layout from '../layouts/Layout.astro';
import { getHome, getSite } from '../lib/content';

const [site, home] = await Promise.all([getSite(), getHome()]);
const { sections } = home;
const endsWithCta = sections.at(-1)?._type === 'cta';
---

<Layout site={site} footerOverlap={endsWithCta}>
  <Sections sections={sections} />
</Layout>

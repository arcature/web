---
import '../styles/global.css';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { Site } from '../lib/content';
import Seo from './Seo.astro';

interface Props {
  site: Site;
  /** Page title, for pages other than the home page. */
  title?: string;
  /** Keep this page out of search engines whatever Site settings say. */
  noIndex?: boolean;
  footerOverlap?: boolean;
  /** Showing drafts inside Sanity's Presentation tool. */
  draftMode?: boolean;
}

const { site, title, noIndex, footerOverlap, draftMode = false } = Astro.props;

// Only preview builds include the overlay; otherwise its CSS would be linked from every page.
const VisualEditing = import.meta.env.SANITY_PREVIEW
  ? (await import('../components/VisualEditing.astro')).default
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Seo site={site} title={title} noIndex={noIndex} draftMode={draftMode} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="overflow-x-clip">
    <a
      href="#main"
      class="label sr-only z-50 bg-paper px-4 py-3 text-ink focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      Skip to content
    </a>
    <Header site={site} />
    <main id="main">
      <slot />
    </main>
    <Footer site={site} overlapPrevious={footerOverlap} />
    {draftMode && VisualEditing && <VisualEditing />}
  </body>
</html>

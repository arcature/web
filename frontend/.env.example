# Sanity project the site reads from (same values as ../studio/.env).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_STUDIO_URL=https://arcature.sanity.studio

# Set to "true" to run like the QA stage: every page renders on request, and
# the click-to-edit overlays load for Sanity's Presentation tool.
SANITY_PREVIEW=

# Viewer token for reading drafts: `npm run dev` and the QA stage always show
# drafts with it (dev falls back to published content without it).
# Create one under sanity.io/manage → API → Tokens. Never commit real values.
SANITY_API_READ_TOKEN=

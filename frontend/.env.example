# Sanity project the site reads from (same values as ../studio/.env).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_STUDIO_URL=https://maestro.sanity.studio

# Set to "true" to run like the QA stage: every page renders on request,
# and /api/draft-mode/enable lets Presentation show drafts.
SANITY_PREVIEW=

# Viewer token for reading drafts (preview only). Create one under
# sanity.io/manage → API → Tokens. Never commit real values.
SANITY_API_READ_TOKEN=

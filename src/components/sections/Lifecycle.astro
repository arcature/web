---
import { Image } from 'astro:assets';
import Button from '../Button.astro';
import { resolveImage, type SectionOf } from '../../lib/content';

type Props = SectionOf<'lifecycle'>;

const { heading, cta, items } = Astro.props;
const uid = `acc-${Math.random().toString(36).slice(2, 8)}`;
const fallback = items.map((item) => resolveImage(item.image)).find(Boolean);
---

<section class="bg-paper">
  <div class="flex flex-col gap-6 border-b border-line px-4 py-12 md:min-h-[189px] md:flex-row md:items-center md:justify-between md:px-16">
    <h2 class="text-headline capitalize">{heading}</h2>
    <Button href={cta.href} label={cta.label} class="self-start md:self-center" />
  </div>

  <ol data-accordion>
    {
      items.map((item, index) => {
        const open = index === 0;
        const image = resolveImage(item.image) ?? fallback;
        // A reused fallback image is decorative; its description lives on the first item.
        const alt = item.image ? item.imageAlt : '';
        const number = String(index + 1).padStart(2, '0');

        return (
          <li class="relative border-b border-line">
            <h3 class="md:w-2/3">
              <button
                type="button"
                id={`${uid}-h${index}`}
                aria-expanded={open ? 'true' : 'false'}
                aria-controls={`${uid}-p${index}`}
                class="group grid min-h-[104px] w-full cursor-pointer grid-cols-[3.5rem_1fr] items-start gap-x-4 px-4 pt-8 pb-7 text-left md:grid-cols-[240px_1fr] md:gap-x-8 md:px-8"
              >
                <span class="text-title uppercase">{number}</span>
                <span class="text-title flex items-start justify-between gap-4 capitalize group-hover:underline">
                  {item.title}
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 16 16"
                    class="mt-2 size-4 shrink-0 transition-transform group-aria-expanded:rotate-45 md:hidden"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path d="M8 1v14M1 8h14" />
                  </svg>
                </span>
              </button>
            </h3>

            <div
              id={`${uid}-p${index}`}
              role="region"
              aria-labelledby={`${uid}-h${index}`}
              hidden={!open}
              class="md:min-h-[321px]"
            >
              <div class="grid grid-cols-[3.5rem_1fr] gap-x-4 px-4 pb-8 md:w-2/3 md:grid-cols-[240px_1fr] md:gap-x-8 md:px-8">
                <ul class="text-muted text-xs leading-5 uppercase max-md:col-span-2 max-md:mb-4 max-md:flex max-md:flex-wrap max-md:gap-x-3 md:-mt-3">
                  {item.tags.map((tag) => <li>{tag}</li>)}
                </ul>
                <div class="max-w-[580px] text-base leading-[1.3] max-md:col-span-2 md:text-xl md:-mt-3">
                  {item.lead && <p>{item.lead}</p>}
                  <p>{item.body}</p>
                </div>
              </div>

              {image && (
                <div class="aspect-[480/425] overflow-hidden md:absolute md:inset-y-0 md:right-0 md:aspect-auto md:w-1/3">
                  <Image src={image} alt={alt} widths={[480, 960]} sizes="(min-width: 768px) 33vw, 100vw" class="size-full object-cover" />
                </div>
              )}
            </div>
          </li>
        );
      })
    }
  </ol>
</section>

<script>
  // APG accordion: one panel open at a time.
  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((accordion) => {
    const buttons = Array.from(accordion.querySelectorAll<HTMLButtonElement>('button[aria-controls]'));

    const setOpen = (target: HTMLButtonElement) => {
      buttons.forEach((button) => {
        const open = button === target && button.getAttribute('aria-expanded') !== 'true';
        const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
        button.setAttribute('aria-expanded', String(open));

        if (panel) {
          panel.hidden = !open;
        }
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => setOpen(button));
    });
  });
</script>

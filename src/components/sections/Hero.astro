---
import Button from '../Button.astro';
import ShapedImage from '../ShapedImage.astro';
import { resolveImage, type SectionOf } from '../../lib/content';

type Props = SectionOf<'hero'> & { isFirst?: boolean };

const { heading, body, cta, image, imageAlt, isFirst = true } = Astro.props;
const Heading = isFirst ? 'h1' : 'h2';

// Stepped silhouette from the Figma vector.
const SHAPE =
  'M580 578L0 578L0 352.585L101.131 352.585L101.131 274.536L276.06 99.881L358.605 99.881L358.605 0L580 0L580 578Z';
---

<section class="grid bg-red md:min-h-[711px] md:grid-cols-2">
  <div class="flex flex-col bg-paper">
    <div class="flex-1 px-4 pt-10 pb-16 md:px-9 md:pt-9 md:pb-8">
      <Heading class="text-display max-w-[648px] capitalize">{heading}</Heading>
    </div>
    <div class="on-dark bg-ink px-4 py-10 text-paper md:mt-auto md:min-h-[229px] md:px-9 md:pt-[63px] md:pb-[63px]">
      <p class="max-w-[648px] text-base leading-[1.3]">{body}</p>
      <Button href={cta.href} label={cta.label} variant="light" class="mt-6" />
    </div>
  </div>

  <div class="flex items-center justify-center px-4 py-12 text-ink/20 md:py-[51px] md:pr-[70px] md:pl-[70px]">
    <ShapedImage
      image={resolveImage(image)}
      alt={imageAlt}
      path={SHAPE}
      width={580}
      height={578}
      class="max-w-[580px]"
    />
  </div>
</section>

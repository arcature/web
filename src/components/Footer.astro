---
import Wordmark from '../assets/brand/wordmark.svg';
import ShapedImage from './ShapedImage.astro';
import type { Site } from '../lib/content';
import { resolveImage } from '../lib/images';

interface Props {
  site: Site;
  /** Let the artwork rise into the preceding dark CTA section, as in the design. */
  overlapPrevious?: boolean;
}

const { site, overlapPrevious = false } = Astro.props;
const { footer } = site;

// "M" silhouette from the Figma boolean (outer shape minus the bottom notch).
const SHAPE =
  'M850.143 366.823L1023.84 193.129L1354.14 383.828L1539 1073.75L0 1073.75L223.536 239.497L638.356 0L850.143 366.823ZM641.301 1073.7L1059.14 1073.7L850.22 789.477L641.301 1073.7Z';
---

<footer class="on-dark relative bg-ink text-paper">
  <div
    class:list={[
      'pointer-events-none absolute inset-x-0 bottom-0 overflow-hidden',
      overlapPrevious ? 'top-[-10vw] xl:top-[-144px]' : 'top-0',
    ]}
    aria-hidden="true"
  >
    <div class="absolute bottom-0 left-[-3.47%] w-[106.9%] text-ink md:top-0 md:bottom-auto">
      <ShapedImage
        image={resolveImage(footer?.image)}
        alt=""
        path={SHAPE}
        width={1539}
        height={1073.75}
        renderWidth={1540}
        filter="saturate(0.61) contrast(0.89) brightness(0.97)"
      />
    </div>
  </div>

  <div class="relative mx-auto flex max-w-[1440px] flex-col px-4 pt-16 pb-6 md:px-[37px] md:pt-[125px]">
    <div class="flex flex-col gap-12 md:flex-row md:justify-between">
      <p class="text-headline max-w-[604px] capitalize">{footer?.tagline}</p>

      <div class="flex gap-16">
        <nav aria-label="Footer">
          <ul class="flex flex-col">
            {
              site.navigation.map((item) => (
                <li>
                  <a href={item.href} class="label inline-flex min-h-11 items-center hover:underline md:min-h-[33px]">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <nav aria-label="Social">
          <ul class="flex flex-col">
            {
              (footer?.social ?? []).map((item) => (
                <li>
                  <a href={item.href} class="label inline-flex min-h-11 items-center hover:underline md:min-h-[33px]">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>

    <Wordmark class="mt-24 h-auto w-full md:mt-[283px]" aria-hidden="true" />

    <div class="mt-5 flex flex-col gap-2 sm:flex-row sm:justify-between">
      <p class="label">{footer?.copyright}</p>
      {
        footer?.credit?.label && (
          <a href={footer.credit.href ?? undefined} class="label inline-flex min-h-11 items-center hover:underline sm:min-h-0">
            {footer.credit.label}
          </a>
        )
      }
    </div>
  </div>
</footer>

{
  "name": "arcature-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "frontend",
    "studio"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "check": "npm run astro -w frontend -- check",
    "studio": "npm run dev -w studio",
    "deploy:studio": "npm run deploy -w studio",
    "typegen": "npm run typegen -w studio"
  },
  "allowScripts": {
    "esbuild": true
  }
}

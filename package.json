{
  "name": "arcature-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "frontend",
    "studio"
  ],
  "scripts": {
    "dev": "run-p dev:*",
    "dev:frontend": "npm run dev -w frontend",
    "dev:studio": "npm run dev -w studio",
    "build": "npm run build -w frontend",
    "check": "npm run check --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w frontend",
    "deploy:studio": "npm run deploy -w studio",
    "typegen": "npm run typegen -w studio"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "^1.1.0"
  }
}

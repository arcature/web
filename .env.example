# Leave unset to edit content locally (writes straight to src/content/*.yaml).
# Set to "owner/repo" to have the deployed /keystatic admin commit via GitHub.
# See https://keystatic.com/docs/github-mode
PUBLIC_KEYSTATIC_GITHUB_REPO=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

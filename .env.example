# Leave unset to edit content locally (writes straight to src/content/*.yaml).
# Set to "github" to edit through GitHub, as the Netlify admin does.
# See https://keystatic.com/docs/github-mode
PUBLIC_KEYSTATIC_STORAGE=

# Written by Keystatic when you create the GitHub App (see README), and copied
# to Netlify's environment variables. Never commit real values.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

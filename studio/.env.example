# Same project and dataset as the site's PUBLIC_SANITY_* variables.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Where Presentation loads the site for visual editing. The deployed Studio
# points at the QA stage (see README).
SANITY_STUDIO_PREVIEW_URL=http://localhost:4321

# Optional. Encrypts the auth tokens saved with each webhook in the Deploy tool;
# without it they're stored in plain text. Generate with `openssl rand -hex 64`.
# Changing it means re-entering every saved token.
SANITY_STUDIO_PLUGIN_WEBHOOKS_ENCRYPTION_SALT=
